rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Admin = Firebase custom claim {admin: true}. Set it with scripts/set-admin-claim.js or the Worker (/admin/user).
    // Never gate on an e-mail address: anyone can register any username.
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    // Per-person permissions: custom claim perms = list of 'orders','pay','products','promos','rentals','boxes','vault','users'.
    // Admins (admin:true) can do everything; settings, roles and login changes stay admin-only.
    function hasPerm(p) { return signedIn() && 'perms' in request.auth.token && p in request.auth.token.perms; }
    function can(p) { return isAdmin() || hasPerm(p); }
    function isStaff() { return hasPerm('orders'); }
    function staffKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function docAt(p) { return path('/databases/' + database + '/documents/' + p); }
    // A suspended account (users/{uid}.status) cannot file orders or top-ups.
    function notSuspended() {
      return !exists(docAt('users/' + request.auth.uid))
        || get(docAt('users/' + request.auth.uid)).data.get('status', 'active') != 'suspended';
    }
    function shortStr(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }

    // ---------- Catalogue ----------
    match /products/{productId} {
      allow read: if true;
      allow write: if can('products');
      allow update: if hasPerm('pay') && staffKeys(['stock', 'updatedAt']); // approving / cancelling an order moves stock
      // Game-ID credentials: admin / products / pay (an approved order hands one out); the Worker bypasses rules.
      match /stock_items/{itemId} { allow read, write: if can('products') || hasPerm('pay'); }
    }
    // Ammo-bundle quotes (ไก่กระสุน): written by the Worker only; admins read them to sort out paid-but-undelivered guests.
    match /ammo_quotes/{id} { allow read: if isAdmin(); allow write: if false; }
    match /categories/{catId} { allow read: if true; allow write: if can('products'); }
    // Codes can be looked up by exact name but not listed.
    match /promo_codes/{code} { allow get: if true; allow list, write: if can('promos'); }
    match /inventory_vault/{vaultId} { allow read, write: if false; }

    // ---------- Orders (customers file pending_payment only; wallet purchases are written by the Worker) ----------
    match /orders/{orderId} {
      // Slips are verified by the Worker only (API check): browsers can no longer file pending orders / top-ups.
      allow create: if false && signedIn() && notSuspended()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending_payment'
        && request.resource.data.paymentMethod in ['promptpay', 'truemoney']
        && request.resource.data.createdAt == request.time
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.quantity <= 100000
        && request.resource.data.subtotal is number
        && request.resource.data.discount is number
        && request.resource.data.discount >= 0
        && request.resource.data.discount <= request.resource.data.subtotal
        && request.resource.data.finalPrice == request.resource.data.amount
        && math.abs(request.resource.data.subtotal - request.resource.data.discount - request.resource.data.amount) < 0.011
        && math.abs(request.resource.data.quantity * request.resource.data.unitPrice - request.resource.data.subtotal) < 0.011
        && request.resource.data.unitPrice >= get(docAt('products/' + request.resource.data.productId)).data.price
        && shortStr(request.resource.data, 'gamePassword', 200) && shortStr(request.resource.data, 'gameEmail', 200)
        && shortStr(request.resource.data, 'paymentProof', 300) && shortStr(request.resource.data, 'buyerContact', 200)
        && shortStr(request.resource.data, 'buyerFacebook', 200) && shortStr(request.resource.data, 'buyerEmail', 200)
        && shortStr(request.resource.data, 'playTime', 200)
        // an attached slip must be registered under its hash in the same batch (slip_hashes blocks reuse)
        && (!('slipHash' in request.resource.data)
            || getAfter(docAt('slip_hashes/' + request.resource.data.slipHash)).data.refId == orderId)
        && request.resource.data.keys().hasOnly([
             'orderNumber', 'orderId', 'productId', 'productName', 'productType',
             'quantity', 'bonusQty', 'receiveQty', 'unit', 'unitPrice', 'subtotal', 'discount', 'promoCode',
             'amount', 'finalPrice', 'paymentMethod', 'paymentProof', 'slipHash', 'hasSlip',
             'buyerEmail', 'buyerFacebook', 'buyerContact', 'gameEmail', 'gamePassword', 'farmMode', 'playTime',
             'status', 'userEmail', 'userId', 'createdAt'
           ]);
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || can('pay') || (isStaff() && resource.data.productType == 'service'));
      allow update, delete: if can('pay');
      // staff: start / finish a paid service job, write a note to the customer, wipe the game password
      allow update: if isStaff() && resource.data.productType == 'service' && resource.data.status == 'processing'
        && request.resource.data.status in ['processing', 'completed']
        && staffKeys(['status', 'queueStatus', 'workStartedAt', 'completedAt', 'gamePassword', 'gamePasswordClearedAt', 'adminNote']);
    }

    // Public service queue: display-only copy of a service order (masked name, no contact/credentials).
    match /queue/{id} {
      allow read: if true;
      // created by the Worker only (wallet checkout); the old browser path below stays off like orders.create
      allow create: if can('pay');
      allow create: if false && signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending_payment'
        && request.resource.data.createdAt == request.time
        && getAfter(docAt('orders/' + id)).data.userId == request.auth.uid
        && getAfter(docAt('orders/' + id)).data.productId == request.resource.data.productId
        && getAfter(docAt('orders/' + id)).data.quantity == request.resource.data.quantity
        && request.resource.data.nameMask.size() <= 8
        && request.resource.data.productName.size() <= 200
        && request.resource.data.unit.size() <= 20
        && request.resource.data.keys().hasOnly(['orderNumber', 'productId', 'productName', 'unit', 'quantity', 'nameMask', 'uid', 'status', 'createdAt']);
      allow update, delete: if can('pay');
      allow update: if isStaff() && request.resource.data.status in ['working', 'done'] && staffKeys(['status', 'startedAt', 'updatedAt']);
    }

    // Public feed of finished orders (home page) and the public counters: written by admin / Worker.
    match /recent_orders/{id} {
      allow read: if true; allow write: if can('pay');
      allow create: if isStaff() && request.resource.data.keys().hasOnly(['productName', 'productId', 'amount', 'buyerMask', 'kind', 'createdAt']);
    }
    match /stats/{docId} {
      allow read: if true;
      allow write: if can('pay');
      // staff finishing a job adds one order and its amount
      allow update: if isStaff() && docId == 'public' && staffKeys(['orders', 'sales'])
        && request.resource.data.orders == resource.data.get('orders', 0) + 1
        && request.resource.data.sales >= resource.data.get('sales', 0) && request.resource.data.sales <= resource.data.get('sales', 0) + 1000000;
      // Signing up adds exactly one to the user counter, in the same batch that creates the caller's profile.
      allow create: if signedIn() && docId == 'public'
        && request.resource.data.keys().hasOnly(['users']) && request.resource.data.users == 1
        && !exists(docAt('users/' + request.auth.uid)) && existsAfter(docAt('users/' + request.auth.uid));
      allow update: if signedIn() && docId == 'public'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['users'])
        && request.resource.data.users == resource.data.get('users', 0) + 1
        && !exists(docAt('users/' + request.auth.uid)) && existsAfter(docAt('users/' + request.auth.uid));
    }

    // ---------- Store settings ----------
    // system/settings (banner, contacts, PromptPay name/number, base stats) and system/promptpay_qr: public.
    match /system/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /system_settings/{docId} { allow read, write: if isAdmin(); }   // admin PIN hash (screen lock only)
    match /system_private/{docId} { allow read, write: if isAdmin(); }    // Discord webhook, provider keys

    // ---------- Users & wallet ----------
    // A user may create / edit their own profile fields; balance, role and status are admin / Worker only.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || hasPerm('users') || hasPerm('vault'));
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'email', 'facebook', 'contactEmail', 'createdAt', 'lastLoginAt'])
        && request.resource.data.createdAt == request.time
        && shortStr(request.resource.data, 'username', 40) && shortStr(request.resource.data, 'facebook', 200)
        && shortStr(request.resource.data, 'contactEmail', 200) && shortStr(request.resource.data, 'email', 200);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'email', 'facebook', 'contactEmail', 'lastLoginAt'])
        && shortStr(request.resource.data, 'username', 40) && shortStr(request.resource.data, 'facebook', 200)
        && shortStr(request.resource.data, 'contactEmail', 200) && shortStr(request.resource.data, 'email', 200);
      // the owner of a vault clears the team-problem counter (only to 0; the Worker raises it)
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vaultAlerts']) && request.resource.data.vaultAlerts == 0;
      allow write: if isAdmin();
      // delegated: wallet / contact fields (users, pay), vault days (vault); role, login and perms never
      allow update: if (hasPerm('users') && staffKeys(['walletBalance', 'username', 'contactEmail', 'facebook', 'status', 'adminUpdatedAt']))
        || (hasPerm('pay') && staffKeys(['walletBalance']))
        || (hasPerm('vault') && staffKeys(['vaultUntil']));
    }
    match /wallet_logs/{id} {
      allow read: if can('users') || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if can('users') || hasPerm('pay');
    }

    match /topup_promos/{id} { allow read: if true; allow write: if can('promos'); }

    function promoBonus(p, amount) {
      return p.get('active', true) == true && amount >= p.minAmount
        ? (p.type == 'percent' ? math.floor(amount * p.value / 100) : math.floor(p.value))
        : -1;
    }
    // A browser can only ask for credit; the bonus must match the named promotion (or be 0 without one).
    match /topup_transactions/{txnId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || can('pay'));
      allow create: if false && signedIn() && notSuspended()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.paymentMethod in ['promptpay', 'truemoney']
        && request.resource.data.amount is number
        && request.resource.data.amount >= 20
        && request.resource.data.amount <= 50000
        && request.resource.data.bonusCredit is number
        && (('promoId' in request.resource.data)
             ? promoBonus(get(docAt('topup_promos/' + request.resource.data.promoId)).data, request.resource.data.amount) == request.resource.data.bonusCredit
             : request.resource.data.bonusCredit == 0)
        && math.abs(request.resource.data.finalCredit - request.resource.data.amount - request.resource.data.bonusCredit) < 0.011
        && shortStr(request.resource.data, 'proofRef', 300)
        && (!('slipHash' in request.resource.data)
            || getAfter(docAt('slip_hashes/' + request.resource.data.slipHash)).data.refId == txnId)
        && request.resource.data.keys().hasOnly([
             'txnId', 'uid', 'email', 'amount', 'bonusCredit', 'finalCredit', 'promoId',
             'paymentMethod', 'proofRef', 'slipHash', 'hasSlip', 'status', 'createdAt'
           ]);
      allow update, delete: if can('pay');
    }

    // ---------- Slips ----------
    // The slip picture of an order / top-up (shrunk JPEG data URL), same id as the order / top-up.
    match /slip_images/{id} {
      allow read: if can('pay') || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if false && signedIn() // Worker only now, like orders.create
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['kind', 'uid', 'image', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.image is string
        && request.resource.data.image.size() < 900000
        && request.resource.data.image.matches('data:image/(jpeg|png|webp);base64,.*')
        && ((request.resource.data.kind == 'order' && getAfter(docAt('orders/' + id)).data.userId == request.auth.uid)
            || (request.resource.data.kind == 'topup' && getAfter(docAt('topup_transactions/' + id)).data.uid == request.auth.uid));
      allow update, delete: if isAdmin();
    }
    // SHA-256 of each slip file ever sent. Create-only, so the same file cannot be sent twice.
    match /slip_hashes/{hash} {
      allow get: if signedIn();
      allow list: if can('pay');
      allow create: if false && signedIn() // Worker only now, like orders.create
        && hash.matches('[0-9a-f]{64}')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['kind', 'refId', 'uid', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.kind == 'order' && getAfter(docAt('orders/' + request.resource.data.refId)).data.slipHash == hash)
            || (request.resource.data.kind == 'topup' && getAfter(docAt('topup_transactions/' + request.resource.data.refId)).data.slipHash == hash));
      allow update, delete: if isAdmin();
    }

    // Server only (Worker with the service account): slip references, throttle, Discord de-dup.
    match /slip_refs/{id} { allow read, write: if false; }
    match /slip_attempts/{id} { allow read, write: if false; }
    match /notify_log/{id} { allow read, write: if false; }
    // Cart: one document per customer, product ids + quantities only (prices and stock are checked by the Worker at checkout).
    match /carts/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 8;
    }
    // Game-ID rentals: written only by the Worker; the renter reads the record (end time, status), never the login.
    match /rentals/{id} {
      allow read: if can('rentals') || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if can('rentals');
    }
    match /angpao_vouchers/{id} { allow read: if isAdmin(); allow write: if false; }

    // Loot boxes (กล่องสุ่ม): the admin defines the boxes and prizes, everyone can read them (odds are shown to players).
    // Every open (price, draw, prize, wallet change) is written only by the Worker; a player reads their own opens, the admin reads all.
    match /boxes/{id} { allow read: if true; allow write: if can('boxes'); }
    match /box_opens/{id} {
      allow read: if can('boxes') || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
    // Public "who just won" strip: only rare and better wins, masked names; written by the Worker.
    match /recent_wins/{id} { allow read: if true; allow write: if can('boxes'); }

    // ID vault (sold access): the owner works freely while users/{uid}.vaultUntil is in the future; only an admin sets that date.
    function vaultOpen(uid) {
      return signedIn() && request.auth.uid == uid
        && get(docAt('users/' + uid)).data.get('vaultUntil', null) != null
        && get(docAt('users/' + uid)).data.vaultUntil > request.time;
    }
    match /vaults/{uid}/{col}/{id} {
      allow read: if can('vault'); // usage stats in the back office
      allow read, delete: if vaultOpen(uid);
      allow create, update: if vaultOpen(uid) && request.resource.data.keys().size() <= 14
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 300))
        && (!('pass' in request.resource.data) || (request.resource.data.pass is string && request.resource.data.pass.size() <= 100));
    }
    // Team tab token = secret; the Worker reads it (no client read), the owner creates / deletes it. One token opens one tab.
    match /vault_links/{token} {
      allow create: if vaultOpen(request.resource.data.uid) && token.matches('[A-Za-z0-9]{20,40}')
        && request.resource.data.keys().hasOnly(['uid', 'tabId', 'name', 'createdAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Team membership (a member works in a leader's team tab): created by the Worker (invite / join); either side can end it.
    match /vault_members/{id} {
      allow read, delete: if signedIn() && (resource.data.member == request.auth.uid || resource.data.owner == request.auth.uid);
      allow create, update: if false;
    }
    // Vault access purchases / trials / admin grants (written by the Worker or an admin), read in the back office.
    match /vault_sales/{id} { allow read, write: if can('vault'); }
    // day codes for the ID vault: created in the back office, redeemed only through the Worker (/vault/redeem)
    match /vault_codes/{code} { allow read, write: if can('vault'); match /uses/{uid} { allow read: if can('vault'); } }
    // Web Push subscriptions: the owner saves / removes their own device; the Worker reads them to send
    match /push_subs/{id} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'endpoint', 'p256dh', 'auth', 'createdAt'])
        && request.resource.data.endpoint is string && request.resource.data.endpoint.size() < 1000 && request.resource.data.endpoint.matches('https://.*');
    }

    match /{document=**} { allow read, write: if false; }
  }
}
